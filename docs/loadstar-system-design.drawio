<mxfile host="app.diagrams.net">
  <diagram name="Loadstar architecture" id="loadstar-arch">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="vpc" value="&lt;b&gt;VPC&lt;/b&gt; (same region as Atlas)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#888888;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="180" y="40" width="330" height="390" as="geometry" />
        </mxCell>
        <mxCell id="asg" value="Auto Scaling Group (1–3)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#888888;verticalAlign=top;fontSize=11;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="330" y="80" width="165" height="300" as="geometry" />
        </mxCell>

        <mxCell id="k6" value="&lt;b&gt;k6&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Separate EC2 (load generator)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="80" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="postman" value="&lt;b&gt;Postman&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Contract tests (CLI in CI)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="250" width="130" height="60" as="geometry" />
        </mxCell>

        <mxCell id="alb" value="&lt;b&gt;ALB&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Health check: GET /health&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;" vertex="1" parent="1">
          <mxGeometry x="195" y="190" width="115" height="60" as="geometry" />
