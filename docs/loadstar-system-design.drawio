        <mxCell id="ex3" value="&lt;b&gt;Express #3&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;EC2 · :3000&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;" vertex="1" parent="1">
          <mxGeometry x="350" y="289" width="125" height="56" as="geometry" />
